# Copy to .env.redwave after creating the RedWave Convex project.
# `npx convex dev --env-file .env.redwave` fills/uses this.
CONVEX_DEPLOYMENT=

# Convex Auth — set these on the RedWave Convex deployment
# (dashboard or `npx convex env set --env-file .env.redwave NAME value`).
# SITE_URL=http://localhost:3003
# AUTH_APP_NAME=RedWave
# AUTH_EMAIL_FROM=RedWave <noreply@redwaveapp.com>
# RESEND_API_KEY=
# AUTH_MOBILE_SCHEME=linkall
# JWT_PRIVATE_KEY=
# JWKS=
