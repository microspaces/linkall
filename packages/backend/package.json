{
  "name": "@linkall/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "convex dev",
    "dev:surroundshow": "convex dev --env-file .env.surroundshow",
    "dev:funfirst": "convex dev --env-file .env.funfirst",
    "seed:surroundshow": "convex run seed:surroundshow --env-file .env.surroundshow",
    "seed:funfirst": "convex run seed:funfirst --env-file .env.funfirst",
    "seed:battleLoco": "convex run seed:battleLoco --env-file .env.funfirst",
    "seed:battleLocoLuxor": "convex run seed:battleLocoLuxor --env-file .env.funfirst",
    "seed:wrestleLoco": "convex run seed:wrestleLoco --env-file .env.funfirst",
    "seed:wrestleLocoLuxor": "convex run seed:wrestleLocoLuxor --env-file .env.funfirst",
    "seed:comedyLocoLuxor": "convex run seed:comedyLocoLuxor --env-file .env.funfirst",
    "seed:barlocoHolidays": "convex run seed:barlocoHolidays --env-file .env.surroundshow",
    "seed:weddingShows": "convex run seed:weddingShows --env-file .env.surroundshow",
    "seed:locoCueShows": "convex run seed:locoCueShows --env-file .env.funfirst",
    "seed:phoneScreens": "convex run seed:phoneScreens --env-file .env.funfirst",
    "seed:venueService": "convex run seed:venueService --env-file .env.funfirst",
    "seed:setlistBits": "convex run seed:setlistBits --env-file .env.funfirst",
    "seed:headcaseBitsNightWall": "convex run seed:headcaseBitsNightWall --env-file .env.funfirst",
    "seed:headcaseBits": "convex run headcaseBits:seed --env-file .env.funfirst",
