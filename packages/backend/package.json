    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit -p convex"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@linkall/brands": "workspace:*",
    "convex": "^1.24.0",
    "jose": "^5.2.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
