# Copy to .env.funfirst after creating the FunFirst Convex project.
# `npx convex dev --env-file .env.funfirst` fills/uses this.
CONVEX_DEPLOYMENT=

# Convex Auth — set these on the FunFirst Convex deployment
# (dashboard or `npx convex env set --env-file .env.funfirst NAME value`).
# SITE_URL=http://localhost:3002
# AUTH_APP_NAME=FunFirst
# AUTH_EMAIL_FROM=FunFirst <noreply@funfirst.com>
# RESEND_API_KEY=
# AUTH_MOBILE_SCHEME=linkall
# JWT_PRIVATE_KEY=
# JWKS=
