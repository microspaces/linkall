# Copy to .env.surroundshow after creating the SurroundShow Convex project.
# `npx convex dev --env-file .env.surroundshow` fills/uses this.
CONVEX_DEPLOYMENT=

# Convex Auth — set these on the SurroundShow Convex deployment
# (dashboard or `npx convex env set --env-file .env.surroundshow NAME value`).
# SITE_URL=http://localhost:3001
# AUTH_APP_NAME=SurroundShow
# AUTH_EMAIL_FROM=SurroundShow <noreply@surroundshow.com>
# RESEND_API_KEY=
# AUTH_MOBILE_SCHEME=linkall
# JWT_PRIVATE_KEY=
# JWKS=
