{
  "expo": {
    "name": "LinkAll",
    "slug": "linkall-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "linkall",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SurroundShow to photograph the projected corner markers so the two projectors can be aligned."
        }
      ]
    ]
  }
}
