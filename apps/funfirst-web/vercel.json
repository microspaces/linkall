{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter funfirst-web build",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "battleloco.com"
        }
      ],
      "destination": "/battle-loco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.battleloco.com"
        }
      ],
      "destination": "/battle-loco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "comedyloco.com"
        }
      ],
      "destination": "/comedy-loco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.comedyloco.com"
        }
      ],
      "destination": "/comedy-loco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "headcaseai.com"
        }
      ],
      "destination": "/head-case"
