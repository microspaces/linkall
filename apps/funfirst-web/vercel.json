{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter funfirst-web build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/performances",
      "destination": "/locos/comedy-loco/performances",
      "permanent": true
    },
    {
      "source": "/performance",
      "destination": "/locos/comedy-loco/performance",
      "permanent": true
    },
    {
      "source": "/performance/screens/:id",
      "destination": "/locos/comedy-loco/performance/screens/:id",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/locos/comedy-loco/games",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "battleloco.com"
        }
      ],
      "destination": "/battle-loco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.battleloco.com"
        }
      ],
      "destination": "/battle-loco"
    }
  ]
}
